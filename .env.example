# Environment Configuration for ECX Hackathon 2026
# Copy this file to .env.local for local development.
# Set these variables in Netlify Dashboard: Site configuration > Environment variables

# =====================================================================
# CLIENT-SIDE VARIABLES (Vite / Browser Bundle)
# Injected at build time by Vite. Must be prefixed with VITE_.
# =====================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Base URL for Digital Pass and QR Verification links (e.g. https://your-site.netlify.app)
VITE_PUBLIC_BASE_URL=https://your-site.netlify.app

# =====================================================================
# SERVER-SIDE ONLY VARIABLES (Netlify Functions)
# Strictly server-side. NEVER prefix with VITE_. NEVER exposed to browser bundles.
# =====================================================================
# 1. Resend API Key for sending registration confirmation emails
RESEND_API_KEY=re_your_api_key_here
SENDER_EMAIL=ECX Hackathon 2026 <onboarding@resend.dev>

# 2. Firebase Admin Credentials for updating Firestore emailStatus in production
# Provide either the entire JSON service account key string:
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or individual credentials:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
