rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admins Collection
    // Users can read their own authorization doc to establish admin session.
    // Writes are restricted to project owners via Firebase Console / Admin CLI.
    match /admins/{adminUid} {
      allow read: if isAuthenticated() && (request.auth.uid == adminUid || isAdmin());
      allow write: if false;
    }

    // Monotonic Team ID Counters Collection
    // Tracks current sequence numbers to guarantee unique, non-reusable IDs.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Hackathon Teams Collection
    // Strictly restricted to authorized EDGECRAFT 2026 administrators only.
    match /teams/{teamId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
