# Environment Configuration for ECX Hackathon 2026
# Copy this file to .env.local for local development.
# Set these variables in Netlify Dashboard: Site configuration > Environment variables

# =====================================================================
# CLIENT-SIDE VARIABLES (Vite / Firebase Client SDK)
# Injected at build time by Vite. Must be prefixed with VITE_.
# =====================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Base URL for Digital Pass and QR Verification links (e.g. https://your-site.netlify.app)
VITE_PUBLIC_BASE_URL=http://localhost:5173
